<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="40dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy &amp; Data Shield"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero-Backend • 100% On-Device Security"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Branding Banner (Matching System Authorized Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_jarvis_card"
                android:padding="22dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_angel_ai_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="ANGEL AI Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="System Authorized ANGEL AI • MD ASLAM"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Neural Assistant Architecture"
                    android:textColor="?attr/themeAccent"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_status_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:layout_marginTop="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_jarvis_mic_center"
                        android:backgroundTint="@color/status_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% PRIVATE • ZERO TRACKING"
                        android:textColor="@color/status_green"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 1: Your Data Is On Your Mobile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA OWNERSHIP &amp; STORAGE"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:letterSpacing="0.10"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_jarvis_icon_square">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_shield"
                            app:tint="?attr/themeAccent"
                            android:contentDescription="Shield" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your data is on your mobile."
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zero external server databases"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="In this app there is no backend, nothing. This is a process, totally local on your mobile and Gemini for your conversation. That&apos;s all. No owner added his database or any sign-up pages."
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="sans-serif" />

                <!-- Bullet guarantees -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•  No Sign-Up, No Accounts, No Trackers"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12.5sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•  Voice Biometrics run 100% locally on-device"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12.5sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•  Direct encrypted TLS 1.3 socket to Gemini Live"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: Open Source Release -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSPARENCY &amp; OPEN SOURCE"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:letterSpacing="0.10"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_jarvis_icon_square">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_stack_memory"
                            app:tint="?attr/themeAccent"
                            android:contentDescription="Code" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Open Source Coming Soon"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full code transparency and verified integrity"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full privacy protection, encrypted communication, and complete on-device security for all your personal data and operations."
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Bottom Disclaimer / Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ANGEL AI • MD ASLAM\nEngineered with complete local privacy &amp; transparency"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
