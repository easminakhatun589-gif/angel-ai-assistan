<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#0F172A"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF"
            android:contentDescription="Close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvProjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D Cyber Game"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvProviderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generated by DeepSeek AI (Coder V3)"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_tts_play"
            app:tint="#00E5FF"
            android:layout_marginEnd="8dp"
            android:contentDescription="Reload" />

        <ImageButton
            android:id="@+id/btnCopyCode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_copy"
            app:tint="#FFFFFF"
            android:contentDescription="Copy Code" />
    </LinearLayout>

    <!-- Tab Selector (For Code mode: Preview vs Source Code) -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#131D31"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tabLivePreview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎮 LIVE PREVIEW"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#334155" />

        <TextView
            android:id="@+id/tabSourceCode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💻 REAL SOURCE CODE"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Main Container: Live WebView -->
    <WebView
        android:id="@+id/webViewLive"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Code View: Monospace Scroll -->
    <ScrollView
        android:id="@+id/scrollCodeView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0A0F1D"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvCodeDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#E0F2FE"
            android:textSize="12sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Photo View: Image display -->
    <LinearLayout
        android:id="@+id/layoutPhotoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#030712"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivGeneratedPhoto"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:contentDescription="Generated Photo" />

        <TextView
            android:id="@+id/tvPhotoPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prompt description here"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePhoto"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Save to Device"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00E5FF"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSharePhoto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Share Photo"
                android:textColor="#00E5FF"
                app:strokeColor="#00E5FF" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
