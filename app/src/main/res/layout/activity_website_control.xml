<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070914"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarWebsiteControl"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0E1225"
        android:elevation="4dp"
        app:title="JARVIS Website Control Agent"
        app:titleTextColor="#F8FAFC"
        app:navigationIcon="@drawable/ic_back" />

    <!-- URL & Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121836"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="#00E5FF" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:src="@drawable/ic_checklist_tasks"
            app:tint="#00E5FF" />

        <EditText
            android:id="@+id/etUrlInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="Enter URL or search website..."
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#00E5FF"
            android:text="GO"
            android:textColor="#070914"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Website Shortcuts Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0E21"
        android:padding="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLovable"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Lovable.dev (AI Web)"
                android:textColor="#F8FAFC"
                app:chipBackgroundColor="#1A2242"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGoogle"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Google"
                android:textColor="#F8FAFC"
                app:chipBackgroundColor="#1A2242"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipYouTube"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="YouTube"
                android:textColor="#F8FAFC"
                app:chipBackgroundColor="#1A2242"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGitHub"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="GitHub"
                android:textColor="#F8FAFC"
                app:chipBackgroundColor="#1A2242"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWikipedia"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Wikipedia"
                android:textColor="#F8FAFC"
                app:chipBackgroundColor="#1A2242"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipChatGPT"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="ChatGPT"
                android:textColor="#F8FAFC"
                app:chipBackgroundColor="#1A2242"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReddit"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reddit"
                android:textColor="#F8FAFC"
                app:chipBackgroundColor="#1A2242"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main WebView Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webViewBrowser"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignParentTop="true"
            android:progressTint="#00E5FF" />

        <!-- AI Voice Status / Floating Instruction Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#CC070914"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvAgentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="JARVIS Web Agent Ready: Give voice command or type instruction..."
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Voice & Action Command Input Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etVoiceCommand"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. 'Jarvis, click login' or 'scroll down'..."
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnVoiceMic"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="#1E293B"
                    android:contentDescription="Voice Command Mic"
                    android:src="@drawable/ic_checklist_tasks"
                    app:tint="#00E5FF" />

                <Button
                    android:id="@+id/btnExecuteCommand"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#00E5FF"
                    android:text="RUN"
                    android:textColor="#070914"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
