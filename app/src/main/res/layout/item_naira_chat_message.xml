<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- User Message Bubble (Right Aligned) -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <!-- Optional User Attached Image -->
        <ImageView
            android:id="@+id/ivUserAttachment"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_jarvis_card"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            android:contentDescription="User attached image" />

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:background="@drawable/bg_jarvis_chat_user"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="Hi"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp">

            <ImageView
                android:id="@+id/btnUserEdit"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_edit"
                app:tint="?attr/themeTextMuted"
                android:layout_marginEnd="10dp" />

            <ImageView
                android:id="@+id/btnUserCopy"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Assistant Message Bubble (Left Aligned) -->
    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="320dp"
            android:background="@drawable/bg_jarvis_chat_assistant"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Hello! I am ANGEL AI. How can I help you build apps or answer questions today?"
            android:textColor="?attr/themeTextPrimary"
            android:fontFamily="sans-serif"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <!-- Optional Assistant Generated Image -->
        <ImageView
            android:id="@+id/ivAssistantImage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_jarvis_card"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:contentDescription="Generated or analyzed image" />

        <!-- Optional Code Snippet Card with Preview & Copy -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutCodeSnippetContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="340dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/themeCardBg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_code_chip"
                        app:tint="?attr/themeAccent"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvCodeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Generated Code Snippet"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPreviewCode"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Preview"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="?attr/themeAccent"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnCopyCodeSnippet"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy"
                        android:textSize="11sp"
                        android:textColor="?attr/themeTextPrimary"
                        android:backgroundTint="?attr/themeCardBorder"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCodeSnippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="// code here"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:padding="10dp"
                    android:maxLines="12"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp">

            <ImageView
                android:id="@+id/btnAssistantCopy"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:layout_marginEnd="12dp" />

            <ImageView
                android:id="@+id/btnAssistantPlay"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_tts_play"
                app:tint="?attr/themeTextMuted" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
